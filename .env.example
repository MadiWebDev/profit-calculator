# ── GetProfitCalc / ProfitCalc — environment variables ─────────────────────
# Copy to .env.local for development. NEVER commit real values.
# Required in production: MONGODB_URI, AUTH_SECRET, PADDLE_API_KEY,
# PADDLE_WEBHOOK_SECRET, CRON_SECRET, ENCRYPTION_KEY (see src/lib/env.ts).

# Core
MONGODB_URI=mongodb://localhost:27017/profitcalc
AUTH_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000
LOG_LEVEL=info
ENFORCE_CSRF=true

# Paddle billing (the only payment provider)
PADDLE_API_KEY=live_or_test_paddle_api_key
PADDLE_WEBHOOK_SECRET=paddle_webhook_secret
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=paddle_client_token
# Price IDs (starter / growth / pro x monthly / quarterly / semiannual / annual)
NEXT_PUBLIC_PADDLE_STARTER_MONTHLY_PRICE_ID=
NEXT_PUBLIC_PADDLE_STARTER_QUARTERLY_PRICE_ID=
NEXT_PUBLIC_PADDLE_STARTER_SEMIANNUAL_PRICE_ID=
NEXT_PUBLIC_PADDLE_STARTER_ANNUAL_PRICE_ID=
NEXT_PUBLIC_PADDLE_GROWTH_MONTHLY_PRICE_ID=
NEXT_PUBLIC_PADDLE_GROWTH_QUARTERLY_PRICE_ID=
NEXT_PUBLIC_PADDLE_GROWTH_SEMIANNUAL_PRICE_ID=
NEXT_PUBLIC_PADDLE_GROWTH_ANNUAL_PRICE_ID=
NEXT_PUBLIC_PADDLE_PRO_MONTHLY_PRICE_ID=
NEXT_PUBLIC_PADDLE_PRO_QUARTERLY_PRICE_ID=
NEXT_PUBLIC_PADDLE_PRO_SEMIANNUAL_PRICE_ID=
NEXT_PUBLIC_PADDLE_PRO_ANNUAL_PRICE_ID=

# Cron (shared bearer secret for /api/cron/*)
CRON_SECRET=change-me-to-a-long-random-string

# Token encryption (AES-256, 32+ chars) — without it, OAuth tokens are stored unencrypted
ENCRYPTION_KEY=change-me-to-at-least-32-characters-long

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=ProfitCalc <hello@example.com>

# Shopify (the only store platform)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Scopes requested: read_orders, read_products, read_inventory, read_customers, read_fulfillments

# Ad platforms
META_APP_ID=
META_APP_SECRET=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=

# Google sign-in (NextAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI insights
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Uploads (Cloudinary, blog images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Distributed rate limiting (optional; falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error tracking
SENTRY_DSN=

# WhatsApp order notifications (Phase 9) — Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ID=
# Public display number used by the share button (optional)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Mock ad data: DEV/TEST ONLY. Never set to true in production.
# When true, ad sync serves fixture data instead of calling ad APIs.
USE_MOCK_ADS=false
AD_MOCK_MODE=false

# API rate limits (optional overrides)
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=60000
